# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me
LOG_LEVEL=INFO
# Required: JWT signing secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIREGISTRY_SECRET_KEY=change-me-generate-a-random-secret
# Required in staging/production (comma-separated), e.g.
# CORS_ALLOWED_ORIGINS=https://__APP_NAME__-fe.bravesky-d9f9eeb7.eastus2.azurecontainerapps.io
CORS_ALLOWED_ORIGINS=

# ── Database / Cache ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/__DB_NAME__
REDIS_URL=redis://localhost:6379/0

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ── Azure Key Vault (optional; set *_KV_URI to source secrets from KV) ────────
AZURE_KEYVAULT_URL=https://zaf-kv-01.vault.azure.net/
# AZURE_OPENAI_API_KEY_KV_URI=https://zaf-kv-01.vault.azure.net/secrets/azure-openai-api-key
# DATABASE_URL_KV_URI=
# REDIS_URL_KV_URI=

# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=__NAMESPACE__
TEMPORAL_TASK_QUEUE_AGENTS=__TASK_QUEUE__

# ── Arize Phoenix Observability ──────────────────────────────────────────────
PHOENIX_HOST=localhost
PHOENIX_PORT=6006
PHOENIX_PROJECT_NAME=__APP_NAME__
# PHOENIX_COLLECTOR_ENDPOINT=https://zaf-phoenix.bravesky-d9f9eeb7.eastus2.azurecontainerapps.io/v1/traces
# ARIZE_PHOENIX_API_KEY=
